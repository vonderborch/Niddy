<pageSystem:Page xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:pageSystem="clr-namespace:Niddy.Avalonia.PageSystem;assembly=Niddy.Avalonia"
                 xmlns:tests="clr-namespace:Niddy.Avalonia.Tests"
                 x:Class="Niddy.Avalonia.Tests.XamlPage"
                 x:DataType="tests:XamlPageDataContext">
    <TextBlock Name="Label" Text="{Binding Name}" />
</pageSystem:Page>
