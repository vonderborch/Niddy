<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <PackageId>Niddy.Core</PackageId>
        <Description>Niddy: my personal .NET utilities. Core helpers (IO, atomic file writes, debounced file watching, app paths, streams, strings, JSON, humanized formatting, retry with backoff), Result and Option types, debounce/throttle and lock-free threading primitives, a rolling file logger, typed JSON settings stores, and platform-native secure storage (macOS Keychain, Windows Credential Manager, Linux Secret Service, with an encrypted-file fallback).</Description>
        <PackageTags>$(PackageTags);helpers;extensions;retry;threading;result;option;debounce;logging;settings;security;keychain;credentials;secure-storage</PackageTags>
        <GeneratePackageOnBuild Condition="'$(Configuration)' != 'Release'">true</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.2" />
      <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Niddy.Core.Tests" />
    </ItemGroup>

</Project>
