<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <PackageId>Niddy.Avalonia</PackageId>
        <Description>Niddy: my personal .NET utilities. Avalonia UI helpers: app hosting, dialogs (window and overlay, including color, markdown, table and web), a page system with menus and keyboard shortcuts, toasts with actions and progress, window and layout memory, a global exception handler, converters, responsive layout, theming and file pickers.</Description>
        <PackageTags>$(PackageTags);avalonia;dialogs;ui;toast;navigation;converters</PackageTags>
        <GeneratePackageOnBuild Condition="'$(Configuration)' != 'Release'">true</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Avalonia" Version="12.1.3" />
      <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.3" />
      <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
      <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
      <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
      <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
      <PackageReference Include="Dock.Controls.ProportionalStackPanel" Version="12.1.0.6" />
      <PackageReference Include="Markdown.Avalonia" Version="12.0.0-a3" />
      <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.2" />
      <PackageReference Include="Westermo.GraphX.Controls.Avalonia.Themes.Fluent" Version="4.2.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="../Niddy.Core/Niddy.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Niddy.Avalonia.Tests" />
    </ItemGroup>

</Project>
