<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="48"
             x:Class="Niddy.Avalonia.Toast.ToastItem"
             Cursor="Hand">

    <Border Name="ToastBorder"
            CornerRadius="6"
            Padding="12 10"
            MinWidth="200"
            MaxWidth="400"
            BoxShadow="0 4 12 0 #40000000">
        <StackPanel Spacing="8">
            <DockPanel>
                <TextBlock Name="IconText" DockPanel.Dock="Left" FontSize="14" Margin="0 0 10 0" VerticalAlignment="Center" />
                <Button Name="ActionButton" DockPanel.Dock="Right" IsVisible="False" Margin="10 0 0 0" Padding="10 4"
                        VerticalAlignment="Center" Foreground="White" Background="#33FFFFFF" BorderThickness="0"
                        Cursor="Hand" Click="ActionButton_OnClick" />
                <Border Name="CountBadge" DockPanel.Dock="Right" IsVisible="False" Margin="8 0 0 0" Padding="6 1"
                        CornerRadius="8" Background="#33FFFFFF" VerticalAlignment="Center">
                    <TextBlock Name="CountText" FontSize="11" Foreground="White" />
                </Border>
                <TextBlock Name="MessageText" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
            <ProgressBar Name="ProgressIndicator" IsVisible="False" Minimum="0" Maximum="1" MinWidth="0"
                         Foreground="White" Background="#33FFFFFF" />
        </StackPanel>
    </Border>

</UserControl>
