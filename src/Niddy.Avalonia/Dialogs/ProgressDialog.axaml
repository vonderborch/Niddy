<dialogs:DialogLayout xmlns="https://github.com/avaloniaui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:dialogs="clr-namespace:Niddy.Avalonia.Dialogs"
                      mc:Ignorable="d" d:DesignWidth="400"
                      x:Class="Niddy.Avalonia.Dialogs.ProgressDialog"
                      x:ClassModifier="internal">

    <ProgressBar Name="ProgressBarMain" Height="16" Minimum="0" Maximum="100" />

    <dialogs:DialogLayout.Buttons>
        <Button Name="ButtonCancel" Click="ButtonCancel_OnClick" />
    </dialogs:DialogLayout.Buttons>
</dialogs:DialogLayout>
