<dialogs:DialogLayout xmlns="https://github.com/avaloniaui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:dialogs="clr-namespace:Niddy.Avalonia.Dialogs"
                      mc:Ignorable="d" d:DesignWidth="400"
                      x:Class="Niddy.Avalonia.Dialogs.ConfirmationDialog"
                      x:ClassModifier="internal">

    <dialogs:DialogLayout.Buttons>
        <Button Name="ButtonNo" Click="ButtonNo_OnClick" />
        <Button Name="ButtonYes" Click="ButtonYes_OnClick" IsDefault="True" />
    </dialogs:DialogLayout.Buttons>
</dialogs:DialogLayout>
