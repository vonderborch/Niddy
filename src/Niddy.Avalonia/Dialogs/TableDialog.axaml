<dialogs:DialogLayout xmlns="https://github.com/avaloniaui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:dialogs="clr-namespace:Niddy.Avalonia.Dialogs"
                      mc:Ignorable="d" d:DesignWidth="700"
                      x:Class="Niddy.Avalonia.Dialogs.TableDialog"
                      x:ClassModifier="internal">

    <DataGrid Name="DataGridItems" MaxHeight="400" IsReadOnly="True" SelectionMode="Single"
              CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal"
              DoubleTapped="DataGridItems_OnDoubleTapped" />

    <dialogs:DialogLayout.Buttons>
        <Button Name="ButtonCancel" Click="ButtonCancel_OnClick" />
        <Button Name="ButtonOk" Click="ButtonOk_OnClick" IsDefault="True" />
    </dialogs:DialogLayout.Buttons>
</dialogs:DialogLayout>
